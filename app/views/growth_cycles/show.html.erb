<%
  status_badge = case @cycle.status
                 when "active" then "<span class=\"badge\" style=\"background-color: var(--accent)\">Active</span>"
                 when "completed" then "<span class=\"badge bg-success\">Completed</span>"
                 else "<span class=\"badge bg-secondary\">Pending</span>"
                 end

  phase_meta = {
    "awareness"     => { label: "Phase 1: Awareness",     objective: @phases["awareness"]&.first&.try(:[], :_objective) },
    "engagement"    => { label: "Phase 2: Engagement",    objective: nil },
    "consolidation" => { label: "Phase 3: Consolidation", objective: nil }
  }
%>

<div class="container py-4">
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex align-items-center gap-3 mb-1">
        <h1 class="mb-0"><%= @cycle.name %></h1>
        <%= status_badge.html_safe %>
      </div>
      <p class="text-muted mb-1"><strong><%= @cycle.organization_name %></strong> &middot; <%= @cycle.time_period %></p>
      <p class="mb-0"><%= @cycle.goal_description %></p>
    </div>
    <div class="col-auto d-flex align-items-start gap-2">
      <%= link_to "Download Markdown", download_growth_cycle_path(@cycle),
            class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "Delete Cycle", growth_cycle_path(@cycle),
            data: { turbo_method: :delete, turbo_confirm: "Delete \"#{@cycle.name}\"? This cannot be undone." },
            class: "btn btn-outline-danger btn-sm" %>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <%= render "phase_column",
            phase_name: "awareness",
            phase_label: "Phase 1: Awareness",
            objective: "Build visibility and attract new prospects to your community.",
            tasks: @phases["awareness"] || [] %>
    </div>
    <div class="col-md-4">
      <%= render "phase_column",
            phase_name: "engagement",
            phase_label: "Phase 2: Engagement",
            objective: "Convert interested prospects into active participants.",
            tasks: @phases["engagement"] || [] %>
    </div>
    <div class="col-md-4">
      <%= render "phase_column",
            phase_name: "consolidation",
            phase_label: "Phase 3: Consolidation",
            objective: "Retain new members and build long-term commitment.",
            tasks: @phases["consolidation"] || [] %>
    </div>
  </div>

  <div class="alert alert-secondary small mb-4">
    This plan was generated by AI based on the goal and audience description you provided. Review tasks with your team and adapt them to your organization's specific context before assigning them.
  </div>

  <div>
    <button class="btn btn-sm btn-outline-secondary mb-2" type="button"
            data-bs-toggle="collapse" data-bs-target="#raw-response">
      Show raw Gemini response
    </button>
    <div class="collapse" id="raw-response">
      <% if @cycle.gemini_raw.blank? %>
        <pre class="small text-muted">No raw response available.</pre>
      <% else %>
        <pre class="small text-muted"><%= @cycle.gemini_raw %></pre>
      <% end %>
    </div>
  </div>
</div>
