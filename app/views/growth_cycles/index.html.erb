<div class="container py-4">
  <div class="row mb-4">
    <div class="col d-flex justify-content-between align-items-center">
      <h1>My Cycles</h1>
      <%= link_to "New Cycle", new_growth_cycle_path, class: "btn btn-accent" %>
    </div>
  </div>

  <% if @cycles.empty? %>
    <div class="row">
      <div class="col-md-6 offset-md-3">
        <div class="card text-center p-5">
          <div class="card-body">
            <h5 class="card-title mb-3">No cycles yet</h5>
            <p class="card-text text-muted mb-4">Create your first growth cycle to get a three-phase action plan from Gemini.</p>
            <%= link_to "Create Your First Cycle", new_growth_cycle_path, class: "btn btn-accent" %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @cycles.each do |cycle| %>
        <div class="col">
          <%= render "cycle_card", cycle: cycle %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
