<% total = cycle.cycle_tasks.count %>
<% completed = cycle.cycle_tasks.where(completed: true).count %>
<% pct = total > 0 ? (completed * 100 / total) : 0 %>

<div class="card h-100">
  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <h5 class="card-title mb-0"><%= cycle.name %></h5>
      <%
        badge_class = case cycle.status
                      when "active" then "text-white"
                      when "completed" then "bg-success"
                      else "bg-secondary"
                      end
      %>
      <% if cycle.status == "active" %>
        <span class="badge" style="background-color: var(--accent)"><%= cycle.status.capitalize %></span>
      <% else %>
        <span class="badge <%= badge_class %>"><%= cycle.status.capitalize %></span>
      <% end %>
    </div>

    <p class="text-muted small mb-1"><%= cycle.organization_name %> &middot; <%= cycle.time_period %></p>
    <p class="card-text small mb-3"><%= truncate(cycle.goal_description, length: 80) %></p>

    <% if total > 0 %>
      <div class="mb-1 d-flex justify-content-between small text-muted">
        <span>Progress</span>
        <span><%= completed %>/<%= total %> tasks</span>
      </div>
      <div class="progress mb-3" style="height: 6px;">
        <div class="progress-bar" role="progressbar" style="width: <%= pct %>%"></div>
      </div>
    <% end %>

    <div class="mt-auto d-flex gap-2">
      <%= link_to "View Plan", growth_cycle_path(cycle), class: "btn btn-sm btn-outline-light flex-grow-1" %>
      <%= link_to "Delete", growth_cycle_path(cycle),
            method: :delete,
            data: { turbo_method: :delete, turbo_confirm: "Delete \"#{cycle.name}\"? This cannot be undone." },
            class: "btn btn-sm btn-outline-danger" %>
    </div>
  </div>
</div>
